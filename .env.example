# LIFF app (LINE Login channel). The LIFF endpoint URL must be the deployed app root.
NEXT_PUBLIC_LIFF_ID=
# LINE Login channel ID, used to verify LIFF ID tokens server-side.
LINE_LOGIN_CHANNEL_ID=

# LINE Messaging API channel (webhook, push, rich menu).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase. The service role key is server-only; never expose it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (vision + text). OPENAI_MODEL defaults to gpt-4o.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Shared secret for the daily summary cron (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Local development outside LINE only. Ignored when NODE_ENV=production.
# ALLOW_DEV_AUTH=true
# NEXT_PUBLIC_DEV_LINE_USER_ID=Udev000000000000000000000000000001
